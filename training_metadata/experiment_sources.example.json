    },
    {
      "name": "matrix",
      "manifest": "${WM_DATA_ROOT}/dataset/wan22_training/matrix_wan22/manifest_wan22.jsonl",
      "quotas": {"smoke": 16, "pilot": 2000, "scale": 5000}
    },
    {
      "name": "mira",
