{
  "schema_version": 1,
  "seed": 20260818,
  "dataset_base_path": "${WM_DATA_ROOT}",
  "emit_relative_paths": true,
  "val_ratio": 0.1,
  "max_source_fraction": 0.3,
  "caption_quality": {
    "min_chars": 24,
    "max_chars": 420,
    "max_exact_caption_repeats": 4,
    "reject_patterns": [
      "\\bvideo[_ -]?id\\s*:",
      "\\bfile(?:name)?\\s*:",
      "^A person performing a daily activity"
    ]
  },
  "sources": [
    {
      "name": "hoigen1m",
      "manifest": "${WM_DATA_ROOT}/dataset/wan22_training/hoigen1m_wan22/manifest_wan22.jsonl",
      "caption_fields": ["prompt", "caption", "caption_detailed"],
      "quotas": {"smoke": 48, "pilot": 10000, "scale": 30000}
    },
    {
      "name": "egoexo4d",
      "manifest": "${WM_DATA_ROOT}/dataset/wan22_training/egoexo4d_wan22/manifest_wan22.jsonl",
      "quotas": {"smoke": 40, "pilot": 6000, "scale": 22000}
    },
    {
      "name": "charades",
      "manifest": "${WM_DATA_ROOT}/dataset/wan22_training/charades_wan22/manifest_wan22.jsonl",
      "quotas": {"smoke": 32, "pilot": 6000, "scale": 20000}
    },
    {
      "name": "noxi",
      "manifest": "${WM_DATA_ROOT}/dataset/wan22_training/noxi_wan22/manifest_wan22.jsonl",
      "quotas": {"smoke": 32, "pilot": 5000, "scale": 12000}
    },
    {
      "name": "direct",
      "manifest": "${WM_DATA_ROOT}/dataset/wan22_training/direct_wan22/manifest_wan22.jsonl",
